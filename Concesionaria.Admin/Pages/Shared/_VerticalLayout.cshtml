@using Concesionaria.Admin.Helpers
@using Concesionaria.Admin.ViewModels
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

@{
    var httpClient = HttpClientFactory.CreateClient();
    var apiBaseUrl = Configuration["API_URL_BASE"];
    var httpContext = Context;

    var consultasNoLeidas = await ConsultaContactoHelper.ObtenerCantidadNoLeidasAsync(httpClient, apiBaseUrl!, httpContext);
    
    var token = httpContext.Request.Cookies["AuthToken"];
    if (string.IsNullOrEmpty(token))
    {
        // Redirige al login si no hay token
        httpContext.Response.Redirect("/Auth/SignIn");        
    }

    var (nombre, apellido) = JwtHelper.ObtenerNombreApellido(token!);
    var modeloSideNav = new SideNavViewModel
    {
        Nombre = nombre,
        Apellido = apellido,
        ConsultasNoLeidas = consultasNoLeidas
    };

    var modeloTopBar = new TopBarViewModel
    {
        Nombre = nombre,
        Apellido = apellido
    };
}

<!DOCTYPE html>

@{
    var html_attributes = ViewBag.HTMLAttributes != null ? ViewBag.HTMLAttributes : "";
    var html_class = ViewBag.HTMLClass != null ? ViewBag.HTMLClass : "";
}

<html lang="en" class="@html_class" @html_attributes>

<head>
    @await Html.PartialAsync("~/Pages/Shared/Partials/_TitleMeta.cshtml")
    @RenderSection("styles", false)
    @await Html.PartialAsync("~/Pages/Shared/Partials/_HeadCSS.cshtml")
</head>

<body>
    <div class="wrapper">


        @await Html.PartialAsync("~/Pages/Shared/Partials/_TopBar.cshtml", modeloTopBar)
        @await Html.PartialAsync("~/Pages/Shared/Partials/_SideNav.cshtml", modeloSideNav)

        <div class="content-page">
            
            @RenderBody()

            @await Html.PartialAsync("~/Pages/Shared/Partials/_Footer.cshtml")

        </div>
    </div>

    @await Html.PartialAsync("~/Pages/Shared/Partials/_FooterScripts.cshtml")

    @RenderSection("scripts", required: false)
    

</body>
</html>