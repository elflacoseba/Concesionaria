@page "/auth-reset-pass"
@model Concesionaria.Admin.Pages.Auth.ResetPassModel

@{
    ViewBag.Title = "Restablecer Contraseña";
    Layout = "~/Pages/Shared/_BaseLayout.cshtml";
}

@section styles
{
}

<div class="auth-box overflow-hidden align-items-center d-flex">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xxl-4 col-md-6 col-sm-8">
                <div class="auth-brand text-center mb-4">
                    <a href="/" class="logo-dark">
                        <img src="~/images/logo-black.png" alt="dark logo" height="32">
                    </a>
                    <a href="/" class="logo-light">
                        <img src="~/images/logo.png" alt="logo" height="32">
                    </a>
                    <h4 class="fw-bold mt-3">¿Olvidaste tu contraseña? | IN+</h4>
                    <p class="text-muted w-lg-75 mx-auto">Introduce tu dirección de correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</p>
                </div>

                <div class="card p-4 rounded-4">
                    <form method="post">
                        <div class="mb-3">
                            <label for="userEmail" class="form-label">E-mail <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="email" class="form-control" id="userEmail" name="email" placeholder="tuemail@mailserver.com" required>
                            </div>
                        </div>                           

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary fw-semibold py-2">Enviar</button>
                        </div>
                    </form>

                    <p class="text-muted text-center mt-4 mb-0">
                       Ir a <a href="auth-sign-in" title="Ir a la página de inicio de sesión" class="text-decoration-underline link-offset-3 fw-semibold">Iniciar Sesión</a>
                    </p>
                </div>

                @if (Model.SuccessMessage != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        <i class="ti ti-alert-octagon fs-xl"></i>
                        @Model.SuccessMessage
                    </div>
                }
                @if (Model.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        <i class="ti ti-alert-triangle fs-xl"></i>
                        @Model.ErrorMessage
                    </div>
                }

                <p class="text-center text-muted mt-4 mb-0">
                    @if (DateTime.Now.Year == 2025)
                    {
                        <span>© 2025</span>
                    }
                    else
                    {
                        <span>© 2025 - @DateTime.Now.Year</span>
                    }

                    - Desarrollada por <a href="https://elflacoseba.dev" target="_blank"
                                          class="fw-semibold">Sebastián Serrisuela</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section scripts
{
}



